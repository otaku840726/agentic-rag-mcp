# ============================================================
# Qdrant Vector Database
# ============================================================
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=your-collection-name

# ============================================================
# Neo4j / AuraDB Graph Database (Optional)
# ============================================================
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687                          # Local Docker
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io         # AuraDB Free
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
GRAPH_PROJECT=smilepay                                  # Logical isolation key

# ============================================================
# Provider API Keys (Configure only what you use)
# ============================================================
OPENAI_API_KEY=your-openai-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# GEMINI_API_KEY=your-gemini-api-key
# VOYAGE_API_KEY=your-voyage-api-key

# Local/Custom OpenAI-compatible Endpoint (e.g., Ollama, vLLM, Minimax)
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=not-needed

# ============================================================
# Component Overrides (Provider & Model)
# ============================================================
# ANALYST: Responsible for reasoning and community labeling
ANALYST_PROVIDER=local
ANALYST_MODEL=minimax-m2.5:cloud

# PLANNER: Responsible for search strategy
# PLANNER_PROVIDER=openai
# PLANNER_MODEL=gpt-4o-mini

# EMBEDDING: Dense vector provider
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Graph Post-Processing Settings
# ============================================================
# Whether to run community detection + LLM labeling after indexing
# Set to false to skip (useful for large codebases where labeling is slow/noisy)
GRAPH_COMMUNITY_ENABLED=true
# Batch size for LLM community labeling (higher = fewer API calls, more context)
GRAPH_COMMUNITY_BATCH_SIZE=20
# Whether to run a global consistency review after labeling all communities
GRAPH_COMMUNITY_GLOBAL_REVIEW=true

# ============================================================
# Indexing Filters
# ============================================================
# INDEX_EXTRA_EXTENSIONS=.tf,.hcl
# INDEX_REMOVE_EXTENSIONS=.json
# INDEX_EXTRA_EXCLUDE_DIRS=tmp,logs

# ============================================================
# PHP / Laravel Module Repos (memberservice, paybnbservice)
# ============================================================
# These repos are Laravel Modules (nwidart/laravel-modules) containing:
#   - PHP backend  : Http/Controllers/*.php, Providers/*.php, etc.
#   - JS/TS frontend: *_UI/src/**/*.{js,jsx,ts,tsx}
#   - Blade templates: Resources/views/*.blade.php
#
# .php is already in the built-in whitelist — no INDEX_EXTRA_EXTENSIONS needed.
# Blade files (.blade.php) are automatically detected and chunked as HTML templates.
#
# ── Qdrant (vector search) ──
# Point index_codebase at the repo root; service/layer are auto-inferred from path.
# Example MCP call:
#   index_codebase(directory="/path/to/sp/memberservice")
#   index_codebase(directory="/path/to/sp/paybnbservice")
#
# ── Neo4j (graph relationships) ──
# PHP-Parser Docker analyzer provides full INHERITS/IMPLEMENTS/CALLS/TRAIT_USE edges.
# It is triggered automatically when composer.json is present and Docker is running.
#
# Build the PHP analyzer Docker image once:
#   cd src/agentic_rag_mcp/analyzers/php
#   docker build -t agentic-rag-php-analyzer:latest .
#
# If Docker is unavailable, PHP files fall back to tree-sitter (Qdrant only,
# no rich graph relationships — Neo4j will have Symbol nodes but fewer edges).
#
# Optional: override the PHP analyzer image name
# ANALYZER_PHP_IMAGE=agentic-rag-php-analyzer:latest
# ANALYZER_PHP_COMMAND={file_path}
#
# Project isolation in Neo4j (recommended: one GRAPH_PROJECT per repo):
# GRAPH_PROJECT=memberservice   # or paybnbservice, or a shared name like "smilepay"
